# Postgres local — só para a suíte do Flask legado (conftest.py usa estes valores
# como default, localhost:5433) e docker-compose-dev.yml. Não é o banco de produção.
POSTGRES_HOST=localhost
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=dev

# Postgres usado pelo Flask legado, pelo scheduler (APScheduler) e pelas
# migrações em database/ (lidas em database/__init__.py, database/migrations/
# e scheduler/__init__.py). Em produção aponta pro Session Pooler do Supabase
# (IPv4). SHOPEE_PG_SSLMODE só é anexado à conexão quando definido
# (ex.: require em deploy externo).
SHOPEE_PG_HOST=change_me
SHOPEE_PG_DB=change_me
SHOPEE_PG_USER=change_me
SHOPEE_PG_PASSWORD=change_me
SHOPEE_PG_SSLMODE=require

# Redis (scheduler/__init__.py lê REDIS_HOST). Opcional.
REDIS_HOST=

# Porta HTTP do gunicorn (gunicorn.conf.py, default 5000; plataformas como
# Render/HF injetam). Também é usada pra montar o default de FLASK_INTERNAL_URL.
PORT=5000

# Painel Jinja legado (index() em "/" + rotas /products, /posts, /users)
# colide de path com o painel novo em React (frontend/, servido pelo Flask
# via web/routes/spa.py). Default "false": React vira o painel principal,
# essas 4 rotas Jinja ficam fora do ar e o catch-all do SPA assume os
# paths. "true" reverte pro Jinja antigo (rollback reversível, sem rebuild
# — só troca a env var e reinicia o processo).
LEGACY_PANEL_ENABLED=false

# OBRIGATÓRIAS pro processo FastAPI (api/main.py, subido via uvicorn em
# gunicorn.conf.py::on_starting) subir com o Supabase funcionando. Nomes
# exatos exigidos por api/config.py (pydantic-settings BaseSettings,
# case-insensitive): SUPABASE_URL -> settings.supabase_url,
# SUPABASE_KEY -> settings.supabase_key. Sem elas, rotas que dependem do
# Supabase respondem 500 (o processo sobe mesmo assim, ver api/main.py).
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=change_me
SUPABASE_KEY=change_me

# Chave de assinatura dos JWTs (HS256) da API nova (api/config.py ->
# settings.api_secret_key; api/routers/auth.py, api/middleware.py). Vazia = tokens
# assinados com chave vazia: SEMPRE definir em produção, com valor longo e aleatório.
# Trocar a chave invalida todos os logins ativos.
API_SECRET_KEY=change_me
# OBRIGATÓRIA: a API aborta o startup se tiver menos de 32 caracteres
# (api/config.py::validate_secrets). APP_ENCRYPTION_KEY também (Fernet válida).
# Bootstrap do admin inicial via GET /startup (só funciona com 0 usuários e
# esta variável definida; remova depois de usar).
STARTUP_ADMIN_PASSWORD=

# URL pública do frontend; usada nos redirects pós-OAuth
# (api/routers/credentials.py -> {FRONTEND_URL}/credentials). Default no código:
# http://localhost:5173. Em produção, o domínio do Render.
FRONTEND_URL=https://seu-dominio.com

# Origens permitidas no CORS da API nova (api/main.py). Lista em formato JSON
# (pydantic-settings). Default no código: localhost:5173 e localhost:3000.
CORS_ORIGINS=["https://seu-dominio.com"]

# Histórico de requisições (api/middleware.py -> tabela request_logs). Default
# false (desligado); produção liga com true.
REQUEST_LOGGING_ENABLED=false

# Bridge HTTP interno Flask <-> FastAPI (api/internal_client.py e
# web/routes/internal.py). INTERNAL_API_SECRET é o segredo compartilhado enviado
# em X-Internal-Secret — se ausente, o Flask responde 403 a toda chamada interna.
# FLASK_INTERNAL_URL: default http://127.0.0.1:$PORT (só mudar se o Flask não
# estiver na própria porta local). API_INTERNAL_URL: onde o proxy /api/* do Flask
# encontra o uvicorn (default http://127.0.0.1:8001, web/routes/api_proxy.py).
INTERNAL_API_SECRET=change_me
FLASK_INTERNAL_URL=http://127.0.0.1:5000
API_INTERNAL_URL=http://127.0.0.1:8001

# https://console.cloudinary.com/app/<id>/settings/api-keys
CLOUDINARY_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_SECRET=change_me

# ---------------------------------------------------------------------------
# Callbacks OAuth a cadastrar nos portais (X Developer Portal, Meta for
# Developers, TikTok for Developers) -- um conjunto por ambiente. O path e
# sempre /api/credentials/<rede>/callback (o proxy Flask so repassa /api/*).
#
#   STAGING   -> host shopee-bot-staging.onrender.com
#   PRODUCAO  -> host shopee-bot-fj0w.onrender.com
#
#   https://<host>/api/credentials/threads/callback
#   https://<host>/api/credentials/x/callback
#   https://<host>/api/credentials/facebook/callback
#   https://<host>/api/credentials/instagram/callback
#   https://<host>/api/credentials/tiktok/callback
#   https://<host>/api/credentials/tiktok/callback/   (TikTok: cadastre TAMBEM
#                                                      a variante com barra final)
#
# Cada *_CALLBACK_URL abaixo deve ser exatamente a URL cadastrada para o host
# do ambiente. Se faltar ID, segredo ou callback de uma rede, "Conectar"
# responde 503 ("configuracao do servidor incompleta").
# ---------------------------------------------------------------------------

# Threads
# https://developers.facebook.com/apps/
# Callback é servido pela API nova (FastAPI, api/routers/credentials.py),
# atrás do proxy Flask — que só roteia /api/<subpath> pro FastAPI
# (ver api/main.py, sem prefixo /api interno, e web/routes/api_proxy.py).
# Por isso o path aqui PRECISA começar com /api/, senão o Flask nunca
# repassa a requisição pro FastAPI.
THREADS_APP_ID=change_me
THREADS_SECRET=change_me
THREADS_PERMISSIONS="threads_basic,threads_content_publish,threads_keyword_search,threads_manage_mentions,threads_manage_replies"
THREADS_CALLBACK_URL=https://seu-dominio.com/api/credentials/threads/callback

# Threads - Credenciais do usuário para postagem direta (opcional, para threads_poster.py)
# (Nota 2026-10-05: nenhum código Python do repositório lê THREADS_USER_ID/
# THREADS_ACCESS_TOKEN nem existe threads_poster.py; o token do Threads é obtido
# via OAuth e salvo cifrado em threads_credentials. Mantidas só por histórico.)
# Obtenha o User ID em: https://developers.facebook.com/tools/explorer/
# Obtenha Access Token de longa duração (60 dias) via OAuth
THREADS_USER_ID=change_me
THREADS_ACCESS_TOKEN=change_me

# X (Twitter) — OAuth 2.0 + PKCE, app ÚNICO da plataforma: X_CLIENT_ID e
# X_CLIENT_SECRET vêm daqui (api/x_oauth.py), do app registrado em
# https://developer.x.com/en/portal/dashboard. Requer "User authentication
# settings" (OAuth 2.0) habilitado no app, com este redirect URI cadastrado —
# e pode exigir tier pago dependendo do volume de posts.
# (Correção 2026-10-05: este bloco dizia que client_id/secret eram por usuário
# via PUT /credentials/x; o código atual lê as duas variáveis do ambiente.)
X_CLIENT_ID=change_me
X_CLIENT_SECRET=change_me
# Callback servido pela API nova atrás do proxy Flask — path PRECISA
# começar com /api/ (mesma razão do THREADS_CALLBACK_URL acima).
X_CALLBACK_URL=https://seu-dominio.com/api/credentials/x/callback

# Instagram — Facebook Login for Business (Instagram Graph API não tem
# OAuth próprio). App único da plataforma, igual ao Threads. Ver
# docstring em api/instagram_oauth.py.
# Callback servido pela API nova atrás do proxy Flask — path PRECISA
# começar com /api/ (mesma razão do THREADS_CALLBACK_URL acima).
INSTAGRAM_APP_ID=change_me
INSTAGRAM_SECRET=change_me
INSTAGRAM_CALLBACK_URL=https://seu-dominio.com/api/credentials/instagram/callback
# Login do Facebook para Empresas > Configurações > (config criada com
# instagram_basic/instagram_content_publish/pages_show_list) — Business
# Login exige config_id, scope= direto não funciona mais (ver docstring).
INSTAGRAM_CONFIG_ID=change_me

# Facebook — publicação em Página, mesmo app Meta do Instagram acima
# (ver docstring em api/facebook_oauth.py).
FACEBOOK_CALLBACK_URL=https://seu-dominio.com/api/credentials/facebook/callback
# Config criada com pages_show_list/pages_read_engagement/pages_manage_posts.
FACEBOOK_CONFIG_ID=change_me

# TikTok — OAuth 2.0 Authorization Code, app ÚNICO da plataforma:
# TIKTOK_CLIENT_KEY e TIKTOK_CLIENT_SECRET vêm daqui (api/tiktok_oauth.py), do app
# registrado em https://developers.tiktok.com/apps/. Exige aprovação de parceiro
# pra "Direct Post" público — ver docstring em apis/tiktok.py.
# (Correção 2026-10-05: o bloco antigo dizia que a Client Key/Secret eram por
# usuário; o código atual lê as duas variáveis do ambiente.)
TIKTOK_CLIENT_KEY=change_me
TIKTOK_CLIENT_SECRET=change_me
# Callback servido pela API nova atrás do proxy Flask — path PRECISA
# começar com /api/ (mesma razão do THREADS_CALLBACK_URL acima).
TIKTOK_PERMISSIONS="user.info.basic,video.publish,video.upload"
TIKTOK_CALLBACK_URL=https://seu-dominio.com/api/credentials/tiktok/callback

# Chave de criptografia das credenciais salvas no banco (Shopee secret,
# Threads access_token). Gerar com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Trocar a chave invalida todas as credenciais já salvas (não há
# recriptografia automática) — guardar com o mesmo cuidado de uma senha.
APP_ENCRYPTION_KEY=change_me
# Só durante rotação de chave: chave ANTERIOR, lida por utils/crypto.py
# (rotate_decrypt). Deixar vazia no uso normal.
APP_ENCRYPTION_KEY_OLD=

# Copywriter IA (apis/llm.py): SEM chave global. Cada usuário cadastra a própria
# chave (Gemini/OpenAI/Anthropic) em Credenciais -> Inteligência Artificial
# (tabela ai_credentials, cifrada com APP_ENCRYPTION_KEY).

# https://flask.palletsprojects.com/en/stable/tutorial/deploy/#configure-the-secret-key
FLASK_SESSION_SECRET=dev_only
# true marca o cookie de sessão do Flask como Secure (web/__init__.py); default false.
FLASK_SESSION_COOKIE_SECURE=false
# Qualquer valor não vazio liga o modo debug do Flask (web/__init__.py). Nunca em produção.
FLASK_DEBUG=
FLASK_UPLOAD_FOLDER=upload
FLASK_MAX_CONTENT_LENGTH=52428800

# https://docs.python.org/3/library/logging.html#levels
LOG_LEVEL=10
